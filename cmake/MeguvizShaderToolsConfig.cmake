include("${CMAKE_CURRENT_LIST_DIR}/MeguvizShaderToolsTargets.cmake")
function(mgst_compile_shaderpack)
  cmake_parse_arguments(MGST "" "REQUEST;OUTPUT;OUT_PACK" "DEPENDS" ${ARGN})
  if(NOT MGST_REQUEST OR NOT MGST_OUTPUT OR NOT MGST_OUT_PACK)
    message(FATAL_ERROR "mgst_compile_shaderpack requires REQUEST, OUTPUT prefix and OUT_PACK variable")
  endif()
  file(READ "${MGST_REQUEST}" request_json)
  set(identity "${request_json}")
  foreach(input IN LISTS MGST_DEPENDS)
    file(SHA256 "${input}" content_hash)
    string(APPEND identity ";${input}=${content_hash}")
  endforeach()
  get_target_property(program MeguvizShaderTools::mgst IMPORTED_LOCATION)
  if(NOT program)
    get_target_property(configs MeguvizShaderTools::mgst IMPORTED_CONFIGURATIONS)
    foreach(config IN LISTS configs)
      get_target_property(program MeguvizShaderTools::mgst "IMPORTED_LOCATION_${config}")
      if(program)
        break()
      endif()
    endforeach()
  endif()
  if(NOT EXISTS "${program}")
    message(FATAL_ERROR "An installed native mgst program is required")
  endif()
  file(SHA256 "${program}" program_hash)
  string(SHA256 generation "${identity};tool=${program_hash}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${MGST_REQUEST}" ${MGST_DEPENDS} "${program}")
  set(root "${MGST_OUTPUT}.generations/${generation}")
  file(MAKE_DIRECTORY "${root}")
  string(JSON profile GET "${request_json}" profile_id)
  string(JSON profile_version GET "${request_json}" profile_version)
  set(index "{\"schema_version\":1,\"profile_id\":\"${profile}\",\"profile_version\":\"${profile_version}\",\"artifacts\":[\"artifact\"]}\n")
  if(EXISTS "${root}/index.json")
    file(READ "${root}/index.json" prior)
  endif()
  if(NOT prior STREQUAL index)
    file(WRITE "${root}/index.json" "${index}")
  endif()
  add_custom_command(OUTPUT "${root}/artifact/artifact.json" "${root}/artifact/shader.spv"
    COMMAND MeguvizShaderTools::mgst compile --request "${MGST_REQUEST}" --out-dir "${root}/artifact" --reuse
    DEPENDS "${MGST_REQUEST}" ${MGST_DEPENDS} MeguvizShaderTools::mgst
    DEPFILE "${root}/artifact/source.d" VERBATIM)
  add_custom_command(OUTPUT "${root}/pack/manifest.json"
    COMMAND MeguvizShaderTools::mgst pack --index "${root}/index.json" --artifacts "${root}" --out-dir "${root}/pack" --reuse
    DEPENDS "${root}/artifact/artifact.json" "${root}/index.json" MeguvizShaderTools::mgst VERBATIM)
  set(${MGST_OUT_PACK} "${root}/pack" PARENT_SCOPE)
endfunction()
